#compdef exc
# zsh completion for exc, generated by `exc completions zsh`.
#
# Load it from ~/.zshrc, after compinit:
#   eval "$(exc completions zsh)"
# or install it as an autoloaded completion function:
#   exc completions zsh > "${fpath[1]}/_exc"
#
# Command and profile names aren't baked in: they're read from the config
# file (honoring any --config on the line being completed) every time you
# press Tab, via the hidden `exc __complete` subcommand.

# Unquote a word from the command line and expand a leading `~/`.
_exc_unquote() {
  REPLY=${(Q)1}
  [[ $REPLY == '~/'* ]] && REPLY=$HOME/${REPLY#\~/}
}

_exc_subcommands() {
  local -a subcmds=(
@SUBCOMMANDS@
  )
  _describe -t subcommands 'exc subcommand' subcmds
}

_exc_commands() {
  local -a cmds=(${(f)"$(command $_exc_bin $_exc_cfg __complete commands 2>/dev/null)"})
  _describe -t exc-commands 'command from config' cmds
}

_exc_profiles() {
  local -a profiles=(${(f)"$(command $_exc_bin $_exc_cfg __complete profiles 2>/dev/null)"})
  _describe -t profiles 'profile from config' profiles
}

_exc() {
  local REPLY _exc_bin i
  local -a _exc_cfg
  _exc_unquote "${words[1]}"
  _exc_bin=$REPLY
  # Pick up --config before `words` gets shifted to the subcommand below,
  # so candidates come from the same config the finished command will use.
  for (( i = 2; i < CURRENT; i++ )); do
    case ${words[i]} in
      --config) _exc_unquote "${words[i+1]}"; _exc_cfg=(--config "$REPLY") ;;
      --config=*) _exc_unquote "${words[i]#--config=}"; _exc_cfg=(--config "$REPLY") ;;
    esac
  done

  local curcontext=$curcontext state state_descr line ret=1
  typeset -A opt_args
  local -a globals=(
    '--config=[path to the config file]:path:_files'
    '--profile=[profile to start the picker on]:profile:_exc_profiles'
    '--theme=[built-in color palette]:theme:(default dark mono)'
    '--no-color[disable all color output]'
    '--no-sysinfo[hide the system-info panel in the picker]'
    '(- *)'{-h,--help}'[print help]'
  )

  _arguments -C $globals \
    '(- *)'{-V,--version}'[print version]' \
    '1: :->first' \
    '*:: :->args' && ret=0

  case $state in
    first)
      _alternative \
        'subcommands:subcommand:_exc_subcommands' \
        'exc-commands:command from config:_exc_commands' && ret=0
      ;;
    args)
      curcontext=${curcontext%:*:*}:exc-${words[1]}:
      case ${words[1]} in
        run) _arguments $globals '1:command from config:_exc_commands' && ret=0 ;;
        list) _arguments $globals '--plain[print one command name per line]' && ret=0 ;;
        validate)
          _arguments $globals \
            '--strict[treat warnings as failures]' \
            '--format=[output format for the report]:format:(text json)' && ret=0
          ;;
        init) _arguments $globals '--force[overwrite an existing config file]' && ret=0 ;;
        completions) _arguments $globals '1:shell:(zsh)' && ret=0 ;;
        help) _arguments '1:subcommand:_exc_subcommands' && ret=0 ;;
        # sysinfo, man, and the `exc <name>` shorthand take no further arguments.
        *) _arguments $globals && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

if [[ $funcstack[1] == _exc ]]; then
  # Autoloaded from $fpath: this file is the body of _exc itself.
  _exc "$@"
elif (( $+functions[compdef] )); then
  compdef _exc exc
else
  print -u2 "exc: zsh completion needs compinit; add 'autoload -Uz compinit && compinit' before the eval line in ~/.zshrc"
fi
